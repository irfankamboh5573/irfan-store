{%- liquid
  assign menu = section.settings.menu
 -%}
<div class="page-width">
<nav class="primary-navigation">
    <ul class="menu flex-wrap">
        {% for link in menu.links %}
            {% if link.links != blank %}
                <li>
                    <details class="dropdown-list">
                        <summary class="flex-between">{{ link.title }}
                            {% render 'icons' , icon_name: 'chevron-down', icon_stroke: 1.5 %}
                        </summary>
                        <ul class="sub-menu">
                            {% for child in link.links %}
                                {% if child.links !=blank %}
                                    <li>
                                        <details class="dropdown-list dropdown-list-nested">
                                            <summary class="flex-between" >{{ child.title }}
                                                {% render 'icons' , icon_name: 'chevron-right', icon_stroke: 1.5 %}
                                            </summary>
                                            <ul class="sub-menu sub-menu--flyouts">
                                                {% for grand_child in child.links %}
                                                    <li>{{ grand_child.title | link_to: grand_child.url, class:"d-block" }}</li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    </li>
                                {% else %}
                                    <li>{{ child.title | link_to: child.url, class:"d-block" }}</li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </details>
                </li>
            {% else %}
                 <li>{{ link.title | link_to: link.url, class:"d-block" }}</li>
            {% endif %}
        {% endfor %}    
    </ul>
</nav>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const dropdowns = document.querySelectorAll(".dropdown-list");

  dropdowns.forEach((dropdown) => {
    const summary = dropdown.querySelector(":scope > summary");

    summary.addEventListener("click", function (event) {
      event.preventDefault();
      dropdown.open = !dropdown.open;
    });
  });
});
</script>

{% schema %}
{
    "name": "header",
    "tag": "section",
    "settings": [
        {
        "type": "link_list",
        "id": "menu",
        "label": "Selcet menu",
        "default":"main-menu"
        }
    ]
}
{% endschema %}